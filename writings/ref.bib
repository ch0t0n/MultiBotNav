@inproceedings{sidiropoulos2024,
	title        = {Reinforcement Learning Agents in Precision Agriculture},
	author       = {Sidiropoulos, George and Kiourt, Chairi},
	year         = {2024},
	booktitle    = {Extended Selected Papers of the 14th International Conference on Information, Intelligence, Systems, and Applications},
	publisher    = {Springer Nature Switzerland},
	address      = {Cham},
	pages        = {188--211},
	isbn         = {978-3-031-67426-6},
	editor       = {Bourbakis, Nikolaos and Tsihrintzis, George A. and Virvou, Maria and Jain, Lakhmi C.},
	abstract     = {In the domain of precision agriculture, the convergence of Artificial Intelligence and precision techniques has revolutionized farming practices. This, has marked an era of enhanced efficiency, productivity, and sustainability through exploiting scientific fields such as Machine Learning, Big Data, Computer Vision, Internet of Things and Robotics being applied in agriculture more and more. Given the frequent need for ongoing decision-making inside dynamically changing environments, precision agriculture emerges as a prime domain for the application of Reinforcement Learning techniques, with multiple future promising outcomes. We analyze the literature and identify three main application categories that have been focused on, namely crop management, water management and robot control. Moreover, we highlight the importance and advantages of exploiting Reinforcement Learning in agriculture and highlight the gaps that exist in the literature. Lastly, we propose a general framework towards the future applications of Reinforcement Learning in the field of agriculture.}
}
